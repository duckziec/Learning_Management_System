# ============================================================
# EduLearn LMS — Local / Docker Compose environment
# Copy from .env.example and fill in your values.
# ⚠  File này đã được gitignore — KHÔNG commit file này.
# ============================================================

# ============================================================
# Shared - dùng chung cho nhiều service
# ============================================================
EUREKA_URL=http://localhost:8761/eureka
FRONTEND_URL=http://localhost:5173

# Redis (Docker Compose local)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redisadmin123
REDIS_TIMEOUT=2s

# MinIO (Docker Compose local)
MINIO_URL=http://minio:9000
MINIO_PUBLIC_URL=http://minio:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# MySQL (Docker Compose local)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_USERNAME=root
MYSQL_ROOT_PASSWORD=mysqladmin123
MYSQL_ROOT_HOST=%
IDENTITY_DB_NAME=identity_lms
COURSE_DB_NAME=course_lms
ASSIGNMENT_DB_NAME=assignment_lms
BLOG_DB_NAME=blog_lms

# MongoDB (Docker Compose local)
MONGODB_HOST=mongodb
MONGO_INITDB_ROOT_USERNAME=mongoadmin
MONGO_INITDB_ROOT_PASSWORD=mongoadmin123
MONGODB_PORT=27017
COURSE_MONGODB_DATABASE=course_lms_mongo
ASSIGNMENT_MONGODB_DATABASE=assignment_lms_mongo
CHATBOT_MONGODB_DATABASE=chatbot_db

# Inter-service direct URLs
IDENTITY_SERVICE_URL=http://identity-service:8081/identity
COURSE_SERVICE_URL=http://course-service:8082/course
ASSIGNMENT_SERVICE_URL=http://assignment-service:8083/assignment
BLOG_SERVICE_URL=http://blog-service:8084/blog
CHATBOT_SERVICE_URL=http://chatbot-service:8085/chatbot

# ============================================================
# service-registry
# ============================================================
SERVICE_REGISTRY_PORT=8761
SERVICE_REGISTRY_LOG_LEVEL=INFO

# ============================================================
# api-gateway
# ============================================================
SERVER_PORT=8080
API_GATEWAY_PORT=8080
API_GATEWAY_LOG_LEVEL=DEBUG
API_GATEWAY_SPRING_CLOUD_GATEWAY_LOG_LEVEL=INFO
API_GATEWAY_REACTOR_NETTY_LOG_LEVEL=INFO

# ⚠ Thay bằng secret ít nhất 64 ký tự ngẫu nhiên
JWT_SIGNER_KEY=replace-with-at-least-64-byte-hs512-secret-key-for-local-dev-only

# Gateway Rate Limit
GATEWAY_RATE_LIMIT_REPLENISH_RATE=10
GATEWAY_RATE_LIMIT_BURST_CAPACITY=20
GATEWAY_AUTH_RATE_LIMIT_REPLENISH_RATE=1
GATEWAY_AUTH_RATE_LIMIT_BURST_CAPACITY=5
GATEWAY_STORAGE_RATE_LIMIT_REPLENISH_RATE=3
GATEWAY_STORAGE_RATE_LIMIT_BURST_CAPACITY=10
GATEWAY_ASSIGNMENT_RATE_LIMIT_REPLENISH_RATE=5
GATEWAY_ASSIGNMENT_RATE_LIMIT_BURST_CAPACITY=10
GATEWAY_CHATBOT_RATE_LIMIT_REPLENISH_RATE=3
GATEWAY_CHATBOT_RATE_LIMIT_BURST_CAPACITY=10

# Gateway Circuit Breaker / TimeLimiter
GATEWAY_CIRCUIT_SLIDING_WINDOW_SIZE=10
GATEWAY_CIRCUIT_MINIMUM_CALLS=5
GATEWAY_CIRCUIT_FAILURE_RATE_THRESHOLD=50
GATEWAY_CIRCUIT_WAIT_DURATION=10s
GATEWAY_CIRCUIT_HALF_OPEN_CALLS=3
GATEWAY_CIRCUIT_TIMEOUT=5s
GATEWAY_ASSIGNMENT_CIRCUIT_TIMEOUT=15s
GATEWAY_CHATBOT_CIRCUIT_TIMEOUT=20s
GATEWAY_STORAGE_CIRCUIT_TIMEOUT=15s

# ============================================================
# identity-service
# ============================================================
IDENTITY_SERVICE_PORT=8081
IDENTITY_LOG_LEVEL=DEBUG

# ⚠ Điền thông tin Gmail App Password của bạn
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-your-gmail@gmail.com
MAIL_PASSWORD=replace-with-gmail-app-password

# DB (dùng MySQL của Docker Compose - tự động override bởi docker-compose.yml)
IDENTITY_URL_DB=jdbc:mysql://mysql:3306/identity_lms?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8&createDatabaseIfNotExist=true
IDENTITY_DB_USERNAME=root
IDENTITY_DB_PASSWORD=mysqladmin123

# JWT lifetime
JWT_ACCESS_DURATION=1800
JWT_REFRESH_DURATION=604800

# OTP
OTP_EXPIRY_MINUTES=15
OTP_MAX_ATTEMPTS=5

# Bootstrap admin
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAMES=admin
BOOTSTRAP_ADMIN_PASSWORDS=admin
BOOTSTRAP_ADMIN_EMAILS=
BOOTSTRAP_ADMIN_FULLNAMES=
BOOTSTRAP_ADMIN_EMAIL_DOMAIN=lms.edu.vn

# Identity Redis cache TTL
IDENTITY_CACHE_TTL_DEFAULT_MINUTES=10
IDENTITY_CACHE_TTL_USER_FULL_MINUTES=15
IDENTITY_CACHE_TTL_USER_EXISTS_MINUTES=10
IDENTITY_CACHE_TTL_ADMIN_LIST_MINUTES=2
IDENTITY_CACHE_TTL_ADMIN_STATS_MINUTES=2
IDENTITY_CACHE_TTL_AUTH_USERNAME_MINUTES=5
IDENTITY_CACHE_TTL_AUTH_EMAIL_MINUTES=5
IDENTITY_CACHE_TTL_AUTH_PROVIDER_MINUTES=5

# Cleanup & internal secret
APP_CLEANUP_CRON=0 0 2 * * *
APP_CLEANUP_ZONE=Asia/Ho_Chi_Minh
INTERNAL_SECRET=dev-internal-secret

# ⚠ Google OAuth — điền Client ID và Secret từ Google Cloud Console của bạn
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_ALLOWED_REDIRECT_URIS=http://localhost:5173/authenticate,https://lmsystem.cloud/authenticate

# MinIO bucket identity
MINIO_IDENTITY_BUCKET=lms-identity-bucket
MINIO_IDENTITY_MAX_FILE_SIZE_BYTES=5242880
MINIO_IDENTITY_PRESIGNED_EXPIRY_MINUTES=5

# ============================================================
# course-service
# ============================================================
COURSE_SERVICE_PORT=8082
COURSE_LOG_LEVEL=DEBUG

# DB (tự động override bởi docker-compose.yml)
COURSE_DB_URL=jdbc:mysql://mysql:3306/course_lms?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8&createDatabaseIfNotExist=true
COURSE_DB_USERNAME=root
COURSE_DB_PASSWORD=mysqladmin123

# MongoDB (tự động override bởi docker-compose.yml)
COURSE_MONGODB_URI=mongodb://mongoadmin:mongoadmin123@mongodb:27017/course_lms_mongo?authSource=admin

COURSE_MULTIPART_MAX_FILE_SIZE=20MB
COURSE_MULTIPART_MAX_REQUEST_SIZE=25MB

MINIO_BUCKET=lms-course-bucket
COURSE_MINIO_PRESIGNED_EXPIRY_MINUTES=5

# Google Calendar — xem README.md về Google Meet placeholder
GOOGLE_SERVICE_ACCOUNT_FILE=classpath:google-service-account.json
GOOGLE_DELEGATED_EMAIL=
GOOGLE_CALENDAR_ID=primary

# ============================================================
# assignment-service
# ============================================================
ASSIGNMENT_SERVICE_PORT=8083
ASSIGNMENT_LOG_LEVEL=DEBUG

# DB (tự động override bởi docker-compose.yml)
ASSIGNMENT_DB_URL=jdbc:mysql://mysql:3306/assignment_lms?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8&createDatabaseIfNotExist=true
ASSIGNMENT_DB_USERNAME=root
ASSIGNMENT_DB_PASSWORD=mysqladmin123

# MongoDB (tự động override bởi docker-compose.yml)
ASSIGNMENT_MONGODB_URI=mongodb://mongoadmin:mongoadmin123@mongodb:27017/assignment_lms_mongo?authSource=admin

# ⚠ Judge0 — điền URL và API key của Judge0 instance bạn tự host
JUDGE_ENGINE=judge0
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=replace-with-judge0-api-key
JUDGE0_MAX_POLL_ATTEMPTS=30
JUDGE0_POLL_INTERVAL_MS=2000

CUSTOM_JUDGE_URL=
CUSTOM_JUDGE_API_KEY=
CUSTOM_JUDGE_MAX_POLL_ATTEMPTS=10
CUSTOM_JUDGE_POLL_INTERVAL_MS=2000

QUIZ_AI_SOURCE_CONTENT_MAX_LENGTH=10000
QUIZ_AI_TEST_CASE_MAX_COUNT=50
QUIZ_ABANDONED_THRESHOLD_DAYS=7
QUIZ_CLEANUP_EXPIRED_CRON=0 * * * * *
QUIZ_CLEANUP_ABANDONED_CRON=0 0 * * * *
QUIZ_CLEANUP_PAGE_SIZE=100

ASSIGNMENT_JUDGE_CORE_POOL_SIZE=4
ASSIGNMENT_JUDGE_MAX_POOL_SIZE=8
ASSIGNMENT_JUDGE_QUEUE_CAPACITY=100
ASSIGNMENT_JUDGE_THREAD_NAME_PREFIX=judge-

ASSIGNMENT_CACHE_TTL_DEFAULT_MINUTES=10
ASSIGNMENT_CACHE_TTL_PROBLEMS_MINUTES=10
ASSIGNMENT_CACHE_TTL_PROBLEM_DETAIL_MINUTES=15
ASSIGNMENT_CACHE_TTL_QUIZZES_MINUTES=5
ASSIGNMENT_CACHE_TTL_TESTCASES_MINUTES=10
ASSIGNMENT_CACHE_TTL_LEADERBOARD_MINUTES=5

ASSIGNMENT_SUBMISSION_STUCK_CLEANUP_CRON=0 */5 * * * *
ASSIGNMENT_SUBMISSION_STUCK_THRESHOLD_MINUTES=10
ASSIGNMENT_COUNTER_SYNC_CRON=0 0 3 * * *
ASSIGNMENT_TEST_CASE_IMPORT_MAX_FILE_SIZE_BYTES=10485760

MINIO_ASSIGNMENT_BUCKET=lms-assignment-bucket
MINIO_ASSIGNMENT_MAX_FILE_SIZE_BYTES=5242880
MINIO_ASSIGNMENT_PRESIGNED_EXPIRY_MINUTES=5

# ============================================================
# blog-service
# ============================================================
BLOG_SERVICE_PORT=8084
BLOG_LOG_LEVEL=DEBUG

# DB (tự động override bởi docker-compose.yml)
BLOG_DB_URL=jdbc:mysql://mysql:3306/blog_lms?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8&createDatabaseIfNotExist=true
BLOG_DB_USERNAME=root
BLOG_DB_PASSWORD=mysqladmin123

BLOG_MULTIPART_MAX_FILE_SIZE=5MB
BLOG_MULTIPART_MAX_REQUEST_SIZE=6MB

MINIO_BLOG_BUCKET=lms-blog-bucket
MINIO_BLOG_MAX_FILE_SIZE_BYTES=5242880
MINIO_BLOG_PUBLIC_READ_ENABLED=true
BLOG_THUMBNAIL_FOLDER=thumbnails

# ============================================================
# chatbot-service
# ============================================================
CHATBOT_SERVICE_PORT=8085

# MongoDB (tự động override bởi docker-compose.yml)
CHATBOT_MONGO_URI=mongodb://mongoadmin:mongoadmin123@mongodb:27017/chatbot_db?authSource=admin

# Redis (Docker Compose local)
CHATBOT_REDIS_HOST=redis
CHATBOT_REDIS_PORT=6379
CHATBOT_REDIS_PASSWORD=redisadmin123
CHATBOT_REDIS_TIMEOUT=2000ms
CHATBOT_REDIS_POOL_MAX_ACTIVE=10
CHATBOT_REDIS_POOL_MAX_IDLE=5
CHATBOT_REDIS_POOL_MIN_IDLE=1
CHATBOT_REDIS_POOL_MAX_WAIT=1000ms

# ⚠ Gemini API — điền API key từ Google AI Studio của bạn (https://aistudio.google.com)
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE_CHAT=0.7
GEMINI_TEMPERATURE_GENERATE=0.3
GEMINI_MAX_RETRY=3
GEMINI_RETRY_BACKOFF=5s
GEMINI_STREAM_TIMEOUT=30s
GEMINI_GENERATE_TIMEOUT=60s
GEMINI_RATE_LIMIT_STUDENT=50
GEMINI_RATE_LIMIT_INSTRUCTOR=100

CHATBOT_WEBCLIENT_MAX_IN_MEMORY_SIZE_BYTES=2097152
CHATBOT_CACHE_TTL_HOURS=24
CHATBOT_CACHE_MAX_MESSAGES=20
CHATBOT_HISTORY_RECENT_LIMIT=20
CHATBOT_HISTORY_RESPONSE_LIMIT=20

CHATBOT_PROMPT_MAX_HISTORY_TOKENS=3000
CHATBOT_PROMPT_EXISTING_TEST_CASES_LIMIT=20
CHATBOT_GENERATE_JSON_PARSE_MAX_RETRY=2
CHATBOT_SESSION_ARCHIVE_CRON=0 0 0 * * *
CHATBOT_SESSION_ARCHIVE_AFTER_DAYS=30
CHATBOT_SESSION_TITLE_MAX_LENGTH=50

CHATBOT_LOG_LEVEL=DEBUG

# ============================================================
# frontend
# ============================================================
VITE_API_BASE_URL=http://localhost:8080
