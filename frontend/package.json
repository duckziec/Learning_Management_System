{
  "name": "edulearn-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:core": "vitest run --coverage --coverage.skipFull --coverage.reporter=text --coverage.include=\"src/context/**/*.{js,jsx}\" --coverage.include=\"src/routes/PrivateRoute.jsx\" --coverage.include=\"src/routes/RoleRoute.jsx\" --coverage.include=\"src/services/api.client.js\" --coverage.include=\"src/services/deviceInfo.js\" --coverage.include=\"src/services/oauthUtils.js\" --coverage.include=\"src/hooks/useAuth.js\" --coverage.include=\"src/hooks/useFileUpload.js\" --coverage.include=\"src/hooks/useJudge0.js\" --coverage.include=\"src/components/ui/Toast.jsx\" --coverage.include=\"src/utils/**/*.{js,jsx}\" --coverage.include=\"src/features/assignment/quiz/utils/**/*.{js,jsx}\""
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "@react-oauth/google": "^0.13.5",
    "axios": "^1.6.8",
    "codemirror": "^6.0.2",
    "framer-motion": "^12.38.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.8",
    "jsdom": "^29.1.1",
    "vite": "^5.2.0",
    "vitest": "^4.1.8"
  }
}
