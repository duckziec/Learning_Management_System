# =========================================================
# EduLearn Frontend Environment Example
# Copy this file to .env and update values for local/dev/prod.
# Vite only exposes variables with the VITE_ prefix to React code.
# =========================================================

# ===== API Gateway =====
# API Gateway base URL. Frontend should call the gateway, not services directly.
VITE_API_BASE_URL=http://localhost:8080

# Default timeout for the main axios client.
VITE_API_TIMEOUT_MS=15000

# ===== Google OAuth =====
# Public Google OAuth client ID for the frontend. This is a fake example value.
VITE_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com

# Frontend callback URI. Must match Google Console and backend allowed redirect URI config.
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/authenticate

# Google OAuth authorize endpoint.
VITE_GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/v2/auth

# ===== Device/IP Info =====
# Public API used to get client IP during login.
VITE_PUBLIC_IP_API_URL=https://api.ipify.org?format=json
VITE_PUBLIC_IP_TIMEOUT_MS=3000

# ===== Admin Dashboard Health Check =====
# These URLs are used only by the admin service status screen.
VITE_GATEWAY_HEALTH_URL=http://localhost:8080/actuator/health/liveness
VITE_IDENTITY_HEALTH_URL=http://localhost:8081/identity/actuator/health
VITE_COURSE_HEALTH_URL=http://localhost:8082/course/actuator/health/liveness
VITE_ASSIGNMENT_HEALTH_URL=http://localhost:8083/assignment/actuator/health/liveness
VITE_BLOG_HEALTH_URL=http://localhost:8084/blog/actuator/health/liveness

# Timeout and refresh interval for admin health checks.
VITE_ADMIN_HEALTH_TIMEOUT_MS=5000
VITE_ADMIN_HEALTH_IDENTITY_TIMEOUT_MS=12000
VITE_ADMIN_HEALTH_REFRESH_INTERVAL_MS=30000
