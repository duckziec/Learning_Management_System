FROM node:20-alpine AS build

WORKDIR /app
COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_BASE_URL
ARG VITE_API_TIMEOUT_MS
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_GOOGLE_REDIRECT_URI
ARG VITE_GOOGLE_AUTH_URI
ARG VITE_PUBLIC_IP_API_URL
ARG VITE_PUBLIC_IP_TIMEOUT_MS
ARG VITE_GATEWAY_HEALTH_URL
ARG VITE_IDENTITY_HEALTH_URL
ARG VITE_COURSE_HEALTH_URL
ARG VITE_ASSIGNMENT_HEALTH_URL
ARG VITE_BLOG_HEALTH_URL
ARG VITE_ADMIN_HEALTH_TIMEOUT_MS
ARG VITE_ADMIN_HEALTH_IDENTITY_TIMEOUT_MS
ARG VITE_ADMIN_HEALTH_REFRESH_INTERVAL_MS

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_API_TIMEOUT_MS=${VITE_API_TIMEOUT_MS}
ENV VITE_GOOGLE_CLIENT_ID=${VITE_GOOGLE_CLIENT_ID}
ENV VITE_GOOGLE_REDIRECT_URI=${VITE_GOOGLE_REDIRECT_URI}
ENV VITE_GOOGLE_AUTH_URI=${VITE_GOOGLE_AUTH_URI}
ENV VITE_PUBLIC_IP_API_URL=${VITE_PUBLIC_IP_API_URL}
ENV VITE_PUBLIC_IP_TIMEOUT_MS=${VITE_PUBLIC_IP_TIMEOUT_MS}
ENV VITE_GATEWAY_HEALTH_URL=${VITE_GATEWAY_HEALTH_URL}
ENV VITE_IDENTITY_HEALTH_URL=${VITE_IDENTITY_HEALTH_URL}
ENV VITE_COURSE_HEALTH_URL=${VITE_COURSE_HEALTH_URL}
ENV VITE_ASSIGNMENT_HEALTH_URL=${VITE_ASSIGNMENT_HEALTH_URL}
ENV VITE_BLOG_HEALTH_URL=${VITE_BLOG_HEALTH_URL}
ENV VITE_ADMIN_HEALTH_TIMEOUT_MS=${VITE_ADMIN_HEALTH_TIMEOUT_MS}
ENV VITE_ADMIN_HEALTH_IDENTITY_TIMEOUT_MS=${VITE_ADMIN_HEALTH_IDENTITY_TIMEOUT_MS}
ENV VITE_ADMIN_HEALTH_REFRESH_INTERVAL_MS=${VITE_ADMIN_HEALTH_REFRESH_INTERVAL_MS}

RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
